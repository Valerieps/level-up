// Cloudflare Worker: the app's files, the API, the live connection and the `Cron` entrypoint (ADR-004, ADR-013).
// Secrets are not here: set GOOGLE_CLIENT_SECRET and BOOTSTRAP_ADMIN_EMAILS with
// `npx wrangler secret put <NAME>`, and locally in .dev.vars (see .dev.vars.example).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "level-up",
  "main": "server/entry/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GROUP", "class_name": "Group" }]
  },
  // Never edit a shipped migration; add the next tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Group"] }],
  // No cron here: the central Worker `cron-central` calls `Cron.tick()` (server/entry/worker.ts) every
  // 15 minutes through a service binding (ADR-013).
  // The empty list is deliberate: Wrangler only removes a deployed schedule when told to, so dropping
  // the key would leave the old cron registered.
  "triggers": { "crons": [] },
  "vars": {
    // Public: the OAuth client ID from Google Cloud. The secret is a secret.
    "GOOGLE_CLIENT_ID": "625557632408-vov9tvva83fbrrei36qrkrddkl0hk5h0.apps.googleusercontent.com"
  },
  // Branch previews (`wrangler preview`, ADR-004) refuse to deploy without this block. Each preview
  // gets its own empty Group namespace, never production's data; it has no secrets, and
  // Google sign-in does not work there (ADR-005), so the public client ID is enough.
  "previews": {
    "vars": {
      "GOOGLE_CLIENT_ID": "625557632408-vov9tvva83fbrrei36qrkrddkl0hk5h0.apps.googleusercontent.com"
    },
    "durable_objects": {
      "bindings": [{ "name": "GROUP", "class_name": "Group" }]
    }
  },
  "observability": { "enabled": true },
  // No Wrangler usage telemetry from builds or CI (docs/SEGURANCA.md).
  "send_metrics": false
}
